//Libraries.
INCLUDE "%WEIDU_LIBRARY_DIR%/components.tpa"
INCLUDE "%WEIDU_LIBRARY_DIR%/installers/tables.tpa"


//Initialization.
LAF get_component_root RET root = dir END
LAF get_component_resources_dir RET resources = dir END


//Install tables.
LAF install_tables STR_VAR
    table = "%resources%/2da/tables.2da"
    dir = "%resources%/2da"
    patches = "%root%/patches/tables.tpa"
END

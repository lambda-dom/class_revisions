DEFINE_PATCH_FUNCTION undead_hunter_exorcism STR_VAR destination = "*" BEGIN
    //Patch in melee effects.
    LPF get_spell_header_count RET headers_count = count END
    FOR (i = 1; i <= headers_count; ++i) BEGIN
        LPF patch_resource_reference INT_VAR
            header = i - 1
            match_opcode = 248              //Melee effect.
        STR_VAR
            resource = "cast_spell_kill_undead_%i%"
            ext = "eff"
            match_resource = "mele#res"
            references = "effects"
        END
    END
END

DEFINE_PATCH_FUNCTION undead_hunter_skeleton_warrior STR_VAR destination = "*" BEGIN

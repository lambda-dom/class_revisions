DEFINE_PATCH_FUNCTION inquisitor_disable_turn_undead STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 12001 END
END

//Iron will.
DEFINE_PATCH_FUNCTION inquisitor_iron_will STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 12002 END
END

DEFINE_PATCH_FUNCTION inquisitor_true_sight STR_VAR destination = "*" BEGIN
    LPF get_spell_res STR_VAR
        spell = "CLERIC_TRUE_SIGHT"
    RET res = resource END

    //Sanitize.
    PATCH_IF NOT (FILE_EXISTS_IN_GAME "%res%.spl") BEGIN
        PATCH_FAIL "inquisitor_true_sight: spell '%res%.spl' does not exist in-game."
    END

    //Patch-in spell.
    LPF ALTER_EFFECT INT_VAR
        check_headers = 1
        verbose = 1
        match_opcode = 146                  //Cast spell
    STR_VAR
        match_resource = "trst#res"
        resource = "%res%"
    END
END

DEFINE_PATCH_FUNCTION inquisitor_dispel_evil STR_VAR destination = "*" BEGIN
    //Get sectype and sanitize.
    LPF get_sectype_id STR_VAR sectype = "k1#dispel" RET sectype_id = id END
    PATCH_IF (sectype_id = 0 - 1) BEGIN
        PATCH_FAIL "inquisitor_dispel_evil: sectype 'k1#dispel' not found."
    END

    PATCH_WITH_SCOPE BEGIN
        LPF get_spell_header_count RET headers_count = count END
        FOR (i = 0; i < headers_count; ++i) BEGIN
            LPF get_spell_header_offset INT_VAR header = i RET header_offset = offset END

            //Patch min level.
            min_level = i + 1
            LPF set_spell_header_field INT_VAR
                header = i
            STR_VAR
                field = "min_level"
                value = "%min_level%"
            END
            
            //Patch dispel level.
            level = i + 1 + ((i + 1)/ 2)
            LPF ALTER_EFFECT INT_VAR
                header = i
                verbose = 1
                match_opcode = 58           //Dispel effects.
                parameter1 = level
            END

            //Clone Dispel [58] into Remove by Sectype [221].
            LPF CLONE_EFFECT INT_VAR
                header = i
                verbose = 1
                match_opcode = 58           //Dispel effects.
                opcode = 221                //Remove by sectype.
                parameter1 = 9              //Level.
                parameter2 = sectype_id
                timing = 3                  //Delayed/limited to guarantee ordering.
            STR_VAR
                insert = "below"
            END
        END
    END
END


//Libraries.
INCLUDE "%WEIDU_LIBRARY_DIR%/arrays.tpa"
INCLUDE "%WEIDU_LIBRARY_DIR%/installers.tpa"
INCLUDE "%WEIDU_LIBRARY_DIR%/spells.tpa"
INCLUDE "%WEIDU_LIBRARY_DIR%/tables.tpa"
INCLUDE "%WEIDU_LIBRARY_DIR%/patchers.tpa"

//Mod libraries.
INCLUDE "%MOD_FOLDER%/lib/utils.tpa"


//Get reference tables. Separately to avoid reference clashing.
LAF get_table_references STR_VAR
    tables = "effects"
RET_ARRAY effects = references END

LAF get_table_references STR_VAR
    tables = "spells"
RET_ARRAY spells = references END


//Patches.
//Paladin casting level.
DEFINE_PATCH_FUNCTION paladin_spell_initial_level STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 10000 END
END

//Paladin spellbook.
DEFINE_PATCH_FUNCTION paladin_spellbook STR_VAR destination = "*" BEGIN
    LPF get_component_resources_dir RET dir END
    LPF compose_spellbook STR_VAR
        table = "%dir%/2da/paladin_spellbook.2da"
    END
END


//Detect Evil.
DEFINE_PATCH_FUNCTION paladin_detect_evil STR_VAR destination = "*" BEGIN
    LPF patch_resource_reference INT_VAR
        match_opcode = 146                  //Cast spell.
    STR_VAR
        resource = "paladin_detect_evil_a"
        match_resource = "cddetevl"
        references = "spells"
    END
END

DEFINE_PATCH_FUNCTION paladin_smite_evil STR_VAR destination = "*" BEGIN
    //Add melee effects.
    LPF get_spell_header_count RET headers_count = count END
    FOR (i = 1; i <= headers_count ; ++i) BEGIN
        LPF patch_resource_reference INT_VAR
            header = i - 1
            match_opcode = 248              //Melee effect.
        STR_VAR
            resource = "damage_evil_%i%"
            ext = "eff"
            match_resource = "mele#res"
            references = "effects"
        END
     END
END

//Auras.
DEFINE_PATCH_FUNCTION paladin_aura_protection STR_VAR destination = "*" BEGIN
    LPF patch_resource_reference INT_VAR
        match_opcode = 272                  //Cast spell on condition.
    STR_VAR
        resource = "paladin_aura_protection_a"
        match_resource = ""
        references = "spells"
    END

    //User information.
    LPF add_display_string INT_VAR tra_ref = 10100 END
END


//Libraries.
INCLUDE "%WEIDU_LIBRARY_DIR%/components.tpa"
INCLUDE "%WEIDU_LIBRARY_DIR%/installers.tpa"
INCLUDE "%WEIDU_LIBRARY_DIR%/patchers.tpa"

//Import compose spellbook from paladin component.
//TODO: refactor to avoid this.
INCLUDE "%MOD_FOLDER%/components/paladin/patches/spells.tpa"


//Initialize
LAF get_component_resources_dir RET resources_dir = dir END

//Get reference tables.
LAF load_table_references STR_VAR
    table = "%resources_dir%/2da/effects.2da"
RET_ARRAY effects = references END

LAF load_table_references STR_VAR
    table = "%resources_dir%/2da/spells.2da"
RET_ARRAY spells = references END


//Blackguard spellbook.
DEFINE_PATCH_FUNCTION blackguard_spellbook STR_VAR destination = "*" BEGIN
    LPF get_component_resources_dir RET resources = dir END
    LPF compose_spellbook STR_VAR
        table = "%resources%/2da/blackguard_spellbook.2da"
    END
END

DEFINE_PATCH_FUNCTION blackguard_spell_initial_level STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 10015 END
END

DEFINE_PATCH_FUNCTION blackguard_spell_level_bonus STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 10005 END
END

DEFINE_PATCH_FUNCTION blackguard_spell_penalty STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 10010 END
END

//Blackguard poison immunity.
DEFINE_PATCH_FUNCTION blackguard_poison_immunity STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 10000 END
END

//Blackguard poison immunity.
DEFINE_PATCH_FUNCTION blackguard_fear_immunity STR_VAR destination = "*" BEGIN
    LPF add_display_string INT_VAR tra_ref = 10001 END
END

//Absorb health.
DEFINE_PATCH_FUNCTION blackguard_absorb_health_a STR_VAR destination = "*" BEGIN
    LPF get_spell_header_count RET headers_count = count END
    FOR (i = 1; i <= headers_count; ++i) BEGIN
        //Patch header min level.
        LPF set_spell_header_field INT_VAR header = i - 1 STR_VAR field = "min_level" value = "%i%" END
        //Patch damage.
        LPF ALTER_SPELL_EFFECT INT_VAR
            header = i
            verbose = 1
            match_opcode = 12               //Damage.
            parameter1 = i * 2
        END
    END
END

DEFINE_PATCH_FUNCTION blackguard_absorb_health STR_VAR destination = "*" BEGIN
    LPF patch_resource_reference INT_VAR
        match_opcode = 146                  //Cast spell.
    STR_VAR
        resource = "blackguard_absorb_health_a"
        match_resource = "absb#res"
        references = "spells"
    END
END

//Poison Weapon.
DEFINE_PATCH_FUNCTION blackguard_poison_weapon_a STR_VAR destination = "*" BEGIN
    LPF get_spell_header_count RET headers_count = count END
    FOR (i = 1; i <= headers_count; ++i) BEGIN
        //Patch header min level.
        LPF set_spell_header_field INT_VAR header = i - 1 STR_VAR field = "min_level" value = "%i%" END
        //Patch poison-over-time damage.
        LPF ALTER_SPELL_EFFECT INT_VAR
            header = i
            verbose = 1
            match_opcode = 25               //Poison.
            duration = i
        END

        //Patch save penalty.
        PATCH_IF (8 <= i) AND (i < 16) BEGIN
            LPF ALTER_EFFECT INT_VAR
                header = i - 1
                verbose = 1
                match_savingthrow = 1 << 2  //Save vs. poison.
                savebonus = 0 - 1
            END
        END

        PATCH_IF i >= 16 BEGIN
            LPF ALTER_EFFECT INT_VAR
                header = i - 1
                verbose = 1
                match_savingthrow = 1 << 2  //Save vs. poison.
                savebonus = 0 - 2
            END
        END
    END
END

DEFINE_PATCH_FUNCTION blackguard_poison_weapon STR_VAR destination = "*" BEGIN
    LPF get_array_element STR_VAR
        array = "effects"
        key = "poison_weapon_a"
    RET res = value END

    //Patch resources.
    PATCH_FOR_EACH opcode IN
        248                                 //Melee hit effect.
        249                                 //Ranged hit effect.
    BEGIN
        LPF ALTER_EFFECT INT_VAR
            check_globals = 0
            verbose = 1
            match_opcode = opcode
        STR_VAR
            match_resource = ""
            resource = "%res%"
        END
    END
END


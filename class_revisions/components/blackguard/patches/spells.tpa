DEFINE_PATCH_FUNCTION blackguard_aura_vengeance STR_VAR destination = "*" BEGIN
    LPF patch_resource_reference INT_VAR
        match_opcode = 272                  //Use Eff on condition.
    STR_VAR
        resource = "blackguard_aura_vengeance_a"
        match_resource = ""
        references = "spells"
    END

    //User information.
    LPF add_display_string INT_VAR tra_ref = 10100 END
END


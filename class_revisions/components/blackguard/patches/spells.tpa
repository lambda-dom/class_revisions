//Aid from Hell.
DEFINE_PATCH_FUNCTION blackguard_aid_hell STR_VAR destination = "*" BEGIN
    LPF get_spell_header_count RET headers_count = count END
    FOR (i = 1; i <= headers_count; ++i) BEGIN
        //Patch header min level.
        PATCH_IF NOT (i = 1) BEGIN
            j = i + 3
            LPF set_spell_header_field INT_VAR header = i - 1 STR_VAR field = "min_level" value = "%j%" END
        END

        LPF ALTER_SPELL_EFFECT INT_VAR
            header = i
            verbose = 1
            duration_high = (i + 3) * 60
        END

        //Patch HP per level bonus.
        PATCH_IF (i <= 7) BEGIN
            LPF ALTER_SPELL_EFFECT INT_VAR
                header = i
                verbose = 1
                match_opcode = 18           //Maximum HP Bonus.
                parameter1 = i + 3
            END
        END ELSE BEGIN
            LPF ALTER_SPELL_EFFECT INT_VAR
                header = i
                verbose = 1
                match_opcode = 18           //Maximum HP Bonus.
                parameter1 = 10
            END
        END
    END
END

//Abyssal rage.
DEFINE_PATCH_FUNCTION blackguard_abyssal_rage STR_VAR destination = "*" BEGIN
    LPF patch_resource_reference INT_VAR
        match_opcode = 146                  //Cast spell.
    STR_VAR
        resource = "blackguard_abyssal_rage_a"
        match_resource = ""
        references = "spells"
    END

    //Correct maze and imprisonment immunities.
    PATCH_WITH_SCOPE BEGIN
        PATCH_FOR_EACH animation IN
            "spmaze2"
            "spmaze1"
        BEGIN
            LPF CLONE_EFFECT INT_VAR
                check_globals = 0
                check_headers = 1
                verbose = 1
                match_opcode = 101              //Immunity to effect.
                match_parameter2 = 213          //Maze.
                multi_match = 1
                opcode = 296                    //Protection from animation.
                parameter1 = 0                  //Cleaning.
                parameter2 = 0
            STR_VAR
                resource = "%animation%"
                insert = "below"
            END
        END

        LPF CLONE_EFFECT INT_VAR
            check_globals = 0
            check_headers = 1
            verbose = 1
            match_opcode = 101              //Immunity to effect.
            match_parameter2 = 213          //Maze.
            multi_match = 1
            opcode = 169                    //Prevent icon.
            parameter1 = 0                  //Cleaning.
            parameter2 = 78                 //Maze.
        STR_VAR
            insert = "below"
        END
    END

    PATCH_WITH_SCOPE BEGIN
        LPF get_spell_res STR_VAR spell = "WIZARD_IMPRISONMENT" RET res = resource END
        PATCH_IF NOT ("%res%" STRING_EQUAL_CASE "*") BEGIN
            LPF CLONE_EFFECT INT_VAR
                check_globals = 0
                check_headers = 1
                verbose = 1
                match_opcode = 101              //Immunity to effect.
                match_parameter2 = 211          //Imprisonment.
                multi_match = 1
                opcode = 206                    //Protection from spell.
                parameter1 = 0                  //Cleaning.
                parameter2 = 0
            STR_VAR
                resource = "%res%"
                insert = "below"
            END

            LPF CLONE_EFFECT INT_VAR
                check_globals = 0
                check_headers = 1
                verbose = 1
                match_opcode = 101              //Immunity to effect.
                match_parameter2 = 211          //Imprisonment.
                multi_match = 1
                opcode = 169                    //Prevent icon.
                parameter1 = 0                  //Cleaning.
                parameter2 = 79                 //Imprisonment.
            STR_VAR
                insert = "below"
            END
        END ELSE BEGIN
            PATCH_FAIL "blackguard_abyssal_rage: id of '%res%' not found."
        END
    END
END

//Abyssal fury.
DEFINE_PATCH_FUNCTION blackguard_abyssal_fury STR_VAR destination = "*" BEGIN
    LPF patch_resource_reference INT_VAR
        match_opcode = 248                  //Melee effect.
    STR_VAR
        resource = "abyssal_fury_a"
        ext = "eff"
        match_resource = ""
        references = "effects"
    END
END


//Descriptions for items created by the Fashion Arrows.
@1000 = "Frost Arrows +1"
@1001 = "These Frost Arrows were created by the Archer's ability Fashion Arrows.

STATISTICS:

Combat Abilities:
  Frost: creatures struck suffer 1d4 cold damage

THAC0: +1 bonus
Damage: 1d6 + 1
Damage type: missile
Weight: 0
Launcher: Bow"

@1010 = "Poisoned Arrows +1"
@1011 = "These Poisoned Arrows were created by the Archer's ability Fashion Arrows.

STATISTICS:

Combat Abilities:
  Empoisoned: creatures struck are poisoned on a failed save vs. poison, suffering 1 poison damage per third of a round for 3 rounds

THAC0: +1 bonus
Damage: 1d6 + 1
Damage type: missile
Weight: 0
Launcher: Bow"

@1020 = "Flaming Arrows +2"
